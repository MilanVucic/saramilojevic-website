---
interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<nav class="back-breadcrumb" aria-label="Breadcrumb">
  <a href={href}>
    <svg class="back-breadcrumb-arrow" viewBox="0 0 16 16" aria-hidden="true">
      <path d="M14 8H2M6.5 3.5 2 8l4.5 4.5" />
    </svg>
    <span>{label}</span>
  </a>
</nav>
