---
interface Props {
  href?: string;
  variant?: 'default' | 'light';
  className?: string;
  type?: 'button' | 'submit' | 'reset';
}

const { href, variant = 'default', className, type = 'button' } = Astro.props;
---
{href
  ? <a href={href} class:list={['button', variant === 'light' && 'light', className]}><slot /></a>
  : <button type={type} class:list={['button', variant === 'light' && 'light', className]}><slot /></button>}
