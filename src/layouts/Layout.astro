---
import { site } from '../lib/content';
import { footerLinks } from '../config/links';
import '../styles/global.css';
interface Props { title: string; description?: string; bodyClass?: string }
const { title, description = site.intro, bodyClass } = Astro.props;
const path = Astro.url.pathname;
const pageTitle = path === '/' ? 'Sara Milojević - Visual Artist' : `${title} - ${site.name}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f4ef" />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="header">
      <a href="/" class="wordmark">{site.name}</a>
      <button class="mobile-menu-toggle" type="button" aria-expanded="false" aria-controls="main-navigation" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>
      <nav id="main-navigation" data-mobile-nav aria-label="Main navigation">
        <a href="/collections/" aria-current={path.startsWith('/collections') || path.startsWith('/collection/') ? 'page' : undefined}>Collections</a>
        <a href="/artworks/" aria-current={path.startsWith('/artworks') || path.startsWith('/artwork/') ? 'page' : undefined}>Artworks</a>
        <a href="/exhibitions/" aria-current={path.startsWith('/exhibitions') || path.startsWith('/exhibition/') ? 'page' : undefined}>Exhibitions</a>
        <a href="/about/" aria-current={path === '/about/' ? 'page' : undefined}>About</a>
        <a href="/contact/" aria-current={path === '/contact/' ? 'page' : undefined}>Contact</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer>
      <div class="footer-bottom">
        <a class="wordmark" href="/">{site.name}</a>
        <nav class="footer-social" aria-label="Social links">
          <a class="social-icon" href={footerLinks.email} aria-label="Email Sara"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1.5"></rect><path d="m4 7 8 6 8-6"></path></svg></a>
          {footerLinks.instagram ? <a class="social-icon" href={footerLinks.instagram} target="_blank" rel="noreferrer" aria-label="Sara Milojević on Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1"></circle></svg></a> : <span class="social-icon is-disabled" aria-label="Instagram link coming soon" role="img"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1"></circle></svg></span>}
          {footerLinks.saatchi ? <a class="social-icon" href={footerLinks.saatchi} target="_blank" rel="noreferrer" aria-label="Sara Milojević on Saatchi Art"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M15.5 8.5c-.8-.7-2-1.1-3.3-1.1-1.8 0-3.2.8-3.2 2.2 0 3.4 6.5 1.5 6.5 5 0 1.4-1.4 2.4-3.5 2.4-1.5 0-2.8-.5-3.7-1.4"></path></svg></a> : <span class="social-icon is-disabled" aria-label="Saatchi Art link coming soon" role="img"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M15.5 8.5c-.8-.7-2-1.1-3.3-1.1-1.8 0-3.2.8-3.2 2.2 0 3.4 6.5 1.5 6.5 5 0 1.4-1.4 2.4-3.5 2.4-1.5 0-2.8-.5-3.7-1.4"></path></svg></span>}
          <a class="social-icon" href={footerLinks.behance} target="_blank" rel="noreferrer" aria-label="Sara Milojević on Behance"><svg class="behance-mark" viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 5.5h6.2c2.8 0 4.5 1.3 4.5 3.5 0 1.3-.7 2.3-1.8 2.9 1.6.5 2.5 1.7 2.5 3.5 0 2.6-2 4-5.1 4H2.5V5.5Zm3 2.6v2.7h2.7c1.2 0 1.8-.5 1.8-1.4s-.6-1.3-1.8-1.3H5.5Zm0 5.1v3.5h3c1.4 0 2.1-.6 2.1-1.7 0-1.2-.8-1.8-2.2-1.8H5.5ZM15 7h6.5v1.8H15V7Zm3.4 3c3.1 0 5.1 2.2 5.1 5.3v.8h-7.2c.2 1.1 1 1.7 2.2 1.7.9 0 1.6-.3 2-.9h2.7c-.7 1.9-2.4 2.9-4.8 2.9-3.1 0-5.2-2-5.2-4.9 0-2.8 2.1-4.9 5.2-4.9Zm0 2.1c-1.1 0-1.8.6-2.1 1.7h4.2c-.2-1.1-1-1.7-2.1-1.7Z"></path></svg></a>
        </nav>
        <span>© {new Date().getFullYear()} · {site.subtitle}</span>
        <a href="#main">Back to top ↑</a>
      </div>
    </footer>
    <script>import '../scripts/app.js';</script>
  </body>
</html>
