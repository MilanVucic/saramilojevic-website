---
import Layout from '../layouts/Layout.astro';
import ArtworkImage from '../components/ArtworkImage.astro';
import { getPortfolio, imageUrl, site } from '../lib/content';
const { works, collections } = await getPortfolio();
---
<Layout title="Contact" description="Contact Sara Milojević for enquiries, collaborations, and conversations.">
  <section class="section contact-page">
    <div>
      <p class="eyebrow">Get in touch</p>
      <h1>Let’s start a<br/><em>conversation.</em></h1>
    </div>
    <div class="contact-panel">
      <p>For artwork enquiries, exhibition opportunities, mural projects, collaborations, and other questions, write to Sara directly.</p>
      <form class="contact-form" data-contact-form action="https://api.web3forms.com/submit" method="POST">
        <input type="hidden" name="access_key" value="8b8c138f-4f4c-47e9-920f-59cfbd559db5" />
        <input type="hidden" name="subject" value="New enquiry from Sara Milojević website" />
        <input type="hidden" name="from_name" value="Sara Milojević website" />
        <input class="botcheck" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />

        <fieldset class="inquiry-toggle">
          <legend>What are you contacting Sara about?</legend>
          <div>
            <label><input type="radio" name="inquiry_type" value="General inquiry" checked /> <span>General inquiry</span></label>
            <label><input type="radio" name="inquiry_type" value="Specific artwork" /> <span>Specific artwork</span></label>
          </div>
        </fieldset>

        <div class="contact-artwork-field" data-artwork-field hidden>
          <label for="contact-artwork">Search artworks</label>
          <div class="contact-artwork-combobox" data-artwork-combobox>
            <input
              id="contact-artwork"
              data-artwork-search
              type="search"
              name="artwork"
              placeholder="Start typing an artwork title"
              autocomplete="off"
              role="combobox"
              aria-autocomplete="list"
              aria-controls="artwork-options"
              aria-expanded="false"
              disabled
            />
            <button class="contact-artwork-clear" data-artwork-clear type="button" aria-label="Remove selected artwork" hidden>×</button>
            <div class="contact-artwork-options" id="artwork-options" data-artwork-options role="listbox" hidden>
            {works.map(artwork => {
              const collection = collections.find(item => item.slug === artwork.collection);
              const image = artwork.images[0];
              return <button
                type="button"
                role="option"
                aria-selected="false"
                data-artwork-option
                data-value={artwork.title}
                data-search={`${artwork.title} ${collection?.title ?? ''}`.toLowerCase()}
                data-slug={artwork.slug}
                data-image={imageUrl(image.src)}
                data-alt={image.alt}
                data-width={image.width}
                data-height={image.height}
                data-collection={collection?.title}
              >
                <ArtworkImage image={image} decorative />
                <span><strong>{artwork.title}</strong><small>{collection?.title}</small></span>
              </button>;
            })}
              <p class="contact-artwork-empty" data-artwork-empty hidden>No artworks found.</p>
            </div>
          </div>
          <figure class="contact-artwork-preview" data-artwork-preview hidden>
            <span class="loading-image" data-image-loader>
              <img alt="" loading="lazy" decoding="async" />
            </span>
            <figcaption>
              <strong data-preview-title></strong>
              <span data-preview-collection></span>
            </figcaption>
          </figure>
        </div>

        <div class="contact-field-row">
          <div><label for="contact-name">Name</label><input id="contact-name" name="name" type="text" autocomplete="name" required /></div>
          <div><label for="contact-email">Email</label><input id="contact-email" name="email" type="email" autocomplete="email" required /></div>
        </div>
        <div class="contact-message-field"><label for="contact-message">Message</label><textarea id="contact-message" name="message" rows="6" required></textarea></div>
        <div class="contact-form-footer">
          <button class="button contact-submit" type="submit">Send enquiry</button>
          <p class="contact-form-status" data-form-status role="status" aria-live="polite"></p>
        </div>
      </form>
      <a class="contact-email" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </section>
</Layout>
