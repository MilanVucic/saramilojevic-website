---
import Layout from '../../layouts/Layout.astro';
import '../../styles/all-works.css';
import ArtworkImage from '../../components/ArtworkImage.astro';
import ArtworkFilters from '../../components/ArtworkFilters.astro';
import CTA from '../../components/CTA.astro';
import { getPortfolio } from '../../lib/content';

const { works, collections } = await getPortfolio();
const types = [
  { value: 'painting', label: 'Painting' },
  { value: 'drawing', label: 'Drawing' },
];
const orderedCollections = [...collections].sort((a, b) => a.order - b.order);
const collectionOrder = new Map(orderedCollections.map((collection, index) => [collection.slug, index]));
const orderedWorks = [...works].sort((a, b) =>
  (collectionOrder.get(a.collection) ?? Number.MAX_SAFE_INTEGER) - (collectionOrder.get(b.collection) ?? Number.MAX_SAFE_INTEGER)
  || a.order - b.order
);
const collectionTitle = (slug: string) => orderedCollections.find(collection => collection.slug === slug)?.title || slug;
const years = [...new Set(orderedWorks.map(artwork => artwork.year).filter((year): year is number => typeof year === 'number'))].sort((a, b) => b - a);
const hasUndatedWorks = orderedWorks.some(artwork => !artwork.year);
const sizeCategory = (width: number, height: number) => {
  const longestSide = Math.max(width, height);
  if (longestSide <= 60) return 'small';
  if (longestSide <= 120) return 'medium';
  return 'large';
};
---
<Layout title="Artworks" description="Browse every published artwork by Sara Milojević.">
  <section class="section all-works-page">
    <header class="all-works-heading">
      <div><p class="eyebrow">Complete archive</p><h1>All artworks</h1></div>
    </header>

    <ArtworkFilters
      collections={orderedCollections.map(collection => ({ value: collection.slug, label: collection.title }))}
      types={types}
      years={years.map(year => ({ value: String(year), label: String(year) }))}
      includeUndated={hasUndatedWorks}
      artworkCount={orderedWorks.length}
    />

    <div class="all-works-grid" data-all-works>
      {orderedWorks.map(artwork => <a
        class="all-work-item"
        href={`/artwork/${artwork.slug}/`}
        data-work-item
        data-collection={artwork.collection}
        data-type={artwork.type}
        data-year={artwork.year ? String(artwork.year) : 'undated'}
        data-size={sizeCategory(artwork.dimensions.widthCm, artwork.dimensions.heightCm)}
        data-search={`${artwork.title} ${collectionTitle(artwork.collection)}`.toLowerCase()}
      >
        <div class="all-work-media"><ArtworkImage image={artwork.images[0]} /></div>
        <div class="all-work-copy">
          <h2>{artwork.title}</h2>
          <p>{collectionTitle(artwork.collection)}{artwork.year && <span class="all-work-inline-year">{` · ${artwork.year}`}</span>}</p>
        </div>
        {artwork.year && <span class="all-work-year">{artwork.year}</span>}
        <p class="all-work-details">{artwork.medium}{artwork.dimensions && ` · ${artwork.dimensions.widthCm} × ${artwork.dimensions.heightCm} cm`}</p>
      </a>)}
    </div>
    <div class="all-works-empty" data-works-empty hidden>
      <p>No artworks match the current search and filters.</p>
      <CTA className="all-works-empty-clear">Clear filters</CTA>
    </div>
  </section>
</Layout>
