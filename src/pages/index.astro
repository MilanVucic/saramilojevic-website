---
import Layout from '../layouts/Layout.astro';
import ArtworkImage from '../components/ArtworkImage.astro';
import ArtworkCard from '../components/ArtworkCard.astro';
import CollectionFeature from '../components/CollectionFeature.astro';
import { getPortfolio, site } from '../lib/content';
const { works, collections } = await getPortfolio();
const hero = works.find(a=>a.slug===site.heroArtwork) || works[0];
const [firstName, ...surname] = site.name.split(' ');
---
<Layout title="Selected works">
  {hero && <section class="hero">
    <div class="hero-art" data-hero><ArtworkImage image={hero.images[0]} eager /><div class="hero-shade"></div></div>
    <div class="hero-copy"><p class="eyebrow">{site.subtitle}</p><h1>{firstName}<br/><em>{surname.join(' ')}</em><span class="hero-dot">.</span></h1><p class="hero-tagline">{site.intro}</p></div>
    <div class="hero-bottom"><span>Selected works{hero.year && ` / ${hero.year}`}</span><a href="#selected">Scroll to explore ↓</a></div>
  </section>}
  <section id="selected" class="section">
    <div class="section-heading"><div><p class="eyebrow">A selection from the studio</p><h2>Selected <em>works</em></h2></div><a class="text-link" href="/collections/">All collections ↗</a></div>
    <div class="works-grid">{works.filter(a=>a.featured).map(a=><ArtworkCard artwork={a}/>)}</div>
  </section>
  <section id="about" class="section about"><div><p class="eyebrow">The artist</p><h2>A practice of<br/><em>looking closer.</em></h2></div><div><p class="intro">{site.intro}</p><p>{site.biography}</p><span class="signature">{site.name}</span></div></section>
  {collections.map(c=><CollectionFeature collection={c} works={works.filter(a=>a.collection===c.slug)}/>)}
  <section class="archive section"><p class="eyebrow">Discover the complete collection</p><h2>Every painting,<br/><em>its own world.</em></h2><a class="button" href="/collections/">View all collections ↗</a></section>
</Layout>
