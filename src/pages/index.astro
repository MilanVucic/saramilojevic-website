---
import Layout from '../layouts/Layout.astro';
import '../styles/home.css';
import LoadingImage from '../components/LoadingImage.astro';
import ArtworkCard from '../components/ArtworkCard.astro';
import CollectionFeature from '../components/CollectionFeature.astro';
import CTA from '../components/CTA.astro';
import AnimatedSignature from '../components/AnimatedSignature.astro';
import ArtistSocialLinks from '../components/ArtistSocialLinks.astro';
import { getPortfolio, imageUrl, responsiveImageSrcSet, responsiveImageUrl, site } from '../lib/content';
const { works, collections } = await getPortfolio();
const resolveHeroEntries = (selections: Array<{ artwork: string; image?: number }>) => selections.flatMap(selection => {
  const work = works.find(item => item.slug === selection.artwork);
  if (!work || work.collection === 'shadowplay') return [];
  const image = work.images[Math.max(0, (selection.image || 1) - 1)] || work.images[0];
  return [{ work, image, src: imageUrl(image.src), mobileSrc: responsiveImageUrl(image.src, 1080), desktopSrc: responsiveImageUrl(image.src, 1920), href: `/artwork/${work.slug}/` }];
});
const desktopHeroEntries = resolveHeroEntries(site.heroDesktopImages);
const mobileHeroEntries = resolveHeroEntries(site.heroMobileImages);
const initialHeroEntry = desktopHeroEntries[0] || mobileHeroEntries[0];
const hero = initialHeroEntry?.work;
const newestWorks = site.newestWorkImages.map(selection => {
  const work = works.find(item => item.slug === selection.artwork);
  if (!work) throw new Error(`Unknown or unpublished artwork in newestWorkImages: ${selection.artwork}`);
  if (!Number.isInteger(selection.image) || selection.image < 1 || !work.images[selection.image - 1]) {
    throw new Error(`Invalid image number in newestWorkImages for ${selection.artwork}: ${selection.image}`);
  }
  return { ...work, images: [work.images[selection.image - 1]] };
});
if (!newestWorks.length) throw new Error('Configure at least one image in newestWorkImages.');
const newestGroups = Array.from({ length: newestWorks.length % 3 === 0 ? newestWorks.length / 3 : newestWorks.length }, (_, index) =>
  Array.from({ length: 3 }, (_, slot) => newestWorks[(index * 3 + slot) % newestWorks.length]),
);
const [firstName, ...surname] = site.name.split(' ');
---
<Layout title="Newest works" description={site.seoDescription} socialImage={initialHeroEntry?.src} socialImageAlt={initialHeroEntry?.image.alt}>
  {hero && <section class="hero">
    <div
      class="hero-art"
      data-hero
      data-hero-desktop-sources={JSON.stringify(desktopHeroEntries.map(entry => entry.desktopSrc))}
      data-hero-desktop-links={JSON.stringify(desktopHeroEntries.map(entry => entry.href))}
      data-hero-mobile-sources={JSON.stringify(mobileHeroEntries.map(entry => entry.mobileSrc))}
      data-hero-mobile-links={JSON.stringify(mobileHeroEntries.map(entry => entry.href))}
    >
      <LoadingImage
        src={initialHeroEntry.desktopSrc}
        mobileSrc={mobileHeroEntries[0]?.mobileSrc}
        width={initialHeroEntry.image.width}
        height={initialHeroEntry.image.height}
        alt="Selected artwork by Sara Milojević"
        eager
        webpSrcSet={responsiveImageSrcSet(initialHeroEntry.image.src)}
      />
      <div class="hero-shade"></div>
    </div>
    <div class="hero-copy"><p class="eyebrow">{site.subtitle}</p><h1>{firstName}<br/><em>{surname.join(' ')}</em></h1><CTA href={initialHeroEntry.href} variant="light" className="hero-artwork-cta">View artwork</CTA></div>
  </section>}
  <section id="newest" class="section" data-reveal>
    <div class="section-heading"><div><p class="eyebrow">The latest from the studio</p><h2>Newest <em>works</em></h2></div><div class="desktop-all-artworks"><CTA href="/artworks/">View all artworks</CTA></div></div>
    <div class="newest-works-stage" data-newest-works data-newest-count={newestWorks.length}>
      {newestGroups.map((group, groupIndex) =>
        <div
          class:list={['works-grid', 'newest-works-group', { 'is-active': groupIndex === 0 }]}
          data-newest-group
          data-group={groupIndex}
          aria-hidden={groupIndex === 0 ? 'false' : 'true'}
        >
          {group.map(artwork => <ArtworkCard artwork={artwork}/>)}
        </div>
      )}
    </div>
    <div class="mobile-all-artworks"><CTA href="/artworks/">All artworks</CTA></div>
  </section>
  <section id="about" class="section about" data-reveal>
    <div><div class="about-home-portrait"><LoadingImage src={responsiveImageUrl('/assets/artist-2.JPG', 1080)} width={3252} height={3752} alt="Sara Milojević holding paintbrushes in her studio" sizes="(max-width: 760px) 88vw, 40vw" webpSrcSet={responsiveImageSrcSet('/assets/artist-2.JPG')} /></div></div>
    <div>
      <p class="intro">{site.intro}</p>
      <div class="about-home-signature-row"><AnimatedSignature className="about-home-signature" /></div>
      <p>{site.biography}</p>
      <div class="about-ctas"><CTA href="/about/">Read about Sara</CTA><CTA href="/exhibitions/">Explore exhibitions</CTA></div>
      <div class="about-social-option">
        <h3>Follow Sara's Work</h3>
        <ArtistSocialLinks />
      </div>
    </div>
  </section>
  <div class="collection-features">
    {collections.map(collection => <CollectionFeature collection={collection} works={works.filter(artwork => artwork.collection === collection.slug)}/>)}
  </div>
  <section class="archive section" data-reveal><p class="eyebrow">Discover the complete collection</p><h2>Every painting,<br/><em>its own world.</em></h2><CTA href="/collections/">View all collections</CTA></section>
</Layout>
