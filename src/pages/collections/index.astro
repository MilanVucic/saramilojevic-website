---
import Layout from '../../layouts/Layout.astro';
import CollectionArchiveRow from '../../components/CollectionArchiveRow.astro';
import { getPortfolio } from '../../lib/content';
const { works, collections } = await getPortfolio();
---
<Layout title="Collections">
  <div class="collection-archive">
    {collections.map((collection, index) => <CollectionArchiveRow collection={collection} works={works.filter(artwork => artwork.collection === collection.slug)} index={index} />)}
  </div>
</Layout>
