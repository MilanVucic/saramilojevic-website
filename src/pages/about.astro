---
import Layout from '../layouts/Layout.astro';
import ImageCarousel from '../components/ImageCarousel.astro';
import ArtistSocialLinks from '../components/ArtistSocialLinks.astro';

const education = [
  { year: '2025', detail: 'Doctor of Arts in Painting, Faculty of Fine Arts, University of Arts in Belgrade', note: 'Doctoral Artistic Project: “Exercises in Tenderness: visual expression of contemporary love discourse”' },
  { year: '2020', detail: 'Master of Fine Arts (MFA) in Painting, Faculty of Fine Arts, University of Arts in Belgrade' },
  { year: '2018', detail: 'Bachelor of Fine Arts (BFA) in Painting, Faculty of Fine Arts, University of Arts in Belgrade' },
  { year: '2014', detail: 'High School of Design (Škola za dizajn), Belgrade' },
];

const soloExhibitions = [
  ['2025', 'Exercises in Tenderness, Gallery of the Faculty of Fine Arts, Belgrade, Serbia', 'exercises-in-tenderness'],
  ['2024', 'The Story That Already Happened: Fragments of Love, Gallery Krug, Petrovac, Serbia'],
  ['2024', 'Favorite Objects, Café-Gallery Meduza, Belgrade, Serbia'],
  ['2023', 'Dreamy Softness, Gallery ŠTAB, Belgrade, Serbia', 'dreamy-softness'],
  ['2022', 'The Root of Bark, Gallery ’73, Belgrade, Serbia', 'root-of-bark'],
  ['2019', 'Landscapes, Not Places, SKC Obrenovac Gallery, Obrenovac, Serbia'],
];

const groupExhibitions = [
  ['2024', 'Collective Exhibition Lost in Translation, Extended Media Section of ULUS, Cvijeta Zuzoric Art Pavilion, Belgrade'],
  ['2024', 'Outdoor exhibition Life in the Block, Municipality Sava, Belgrade'],
  ['2024', 'Annual Exhibition of Painting Section Organism, ULUS, Belgrade'],
  ['2024', 'Artistic Residency, Javorwood Festival, Bjelašnica, Bosnia & Herzegovina'],
  ['2023', 'Biennale of Youth: My Name is Quite Ordinary, Cvijeta Zuzoric Art Pavilion, Belgrade'],
  ['2023', 'Group exhibition ART DRAGSTOR, Gallery STAB, Belgrade'],
  ['2023', 'Spring Exhibition ULUS End of Capitalism, Goodbye, Cvijeta Zuzoric Art Pavilion, Belgrade'],
  ['2023', 'Public Project Speakers in Color: What Are You Doing? I Whitewashed Ugly Words, Obrenovac'],
  ['2023', 'Exceptional Women of Serbia Project; mural dedicated to Vera Crvenčanin Kulenović, first Serbian female director and dramaturg, Novi Sad'],
  ['2022', 'Project They Live: Exhibition & Mural, in partnership with the Youth Foundation, SKC Obrenovac, Obrenovac'],
];

const portraitItems = [
  {
    image: { src: '/assets/artist-1.JPG', alt: 'Portrait of Sara Milojević', width: 1452, height: 1390 },
    title: 'Sara Milojević',
  },
  {
    image: { src: '/assets/artist-2.JPG', alt: 'Sara Milojević holding paintbrushes in her studio', width: 3252, height: 3752 },
    title: 'Sara Milojević',
  },
  {
    image: { src: '/assets/artist-3.JPG', alt: 'Sara Milojević standing beside a large green and pink painting in her atelier', width: 4320, height: 3456 },
    title: 'Sara Milojević',
    slideClass: 'about-carousel-slide-atelier',
  },
];
---
<Layout title="About" description="About contemporary visual artist, painter, and muralist Sara Milojević." socialImage="/assets/artist-1-1080w.webp" socialImageAlt="Portrait of Sara Milojević">
  <section class="section about-hero">
    <div class="about-portrait-column">
      <p class="eyebrow">The artist</p>
      <h1>Sara<br/><em>Milojević</em></h1>
      <ImageCarousel
        items={portraitItems}
        label="Portraits of Sara Milojević"
        className="about-portrait"
        viewportClass="about-carousel-viewport"
        slideClass="about-carousel-slide"
        controlsClass="about-carousel-controls"
        eagerFirst
      />
    </div>
    <div class="about-biography">
      <div class="about-copy">
        <p>Sara Milojević (b. 1995, Belgrade) is a contemporary visual artist, painter, and muralist who holds a Doctor of Arts degree from the Faculty of Fine Arts in Belgrade. Embracing the identity of a “stylistic nomad,” her vibrant practice spans from intimate, large-scale drawings and paintings on paper and canvas to impactful public art. Alongside her gallery work, Sara is a co-founder of the informal art collective “Speakers in Color”, focusing on social activism through street art and large-scale murals.</p>
        <p>Her academic excellence has been recognized with prestigious national fellowships and awards for her drawings and mosaics. She has been an independent artist and a member of the <a href="https://ulus.rs/" target="_blank" rel="noopener noreferrer">Association of Fine Artists of Serbia (ULUS)</a> since 2020, as well as an honorary member of the cultural exchange association “Amici del Futuro” (Serbia/Italy). To date, Sara has showcased her work in 6 solo exhibitions and over 40 group exhibitions both domestically and internationally, positioning herself as a distinct voice in contemporary art.</p>
      </div>
      <div class="about-discover">
        <h2>Discover more of Sara’s work</h2>
        <p>Follow her latest work, explore her paintings, and find out about upcoming exhibitions.</p>
        <ArtistSocialLinks />
      </div>
    </div>
  </section>

  <section class="section cv-section" aria-labelledby="education-heading">
    <div class="cv-heading"><p class="eyebrow">Background</p><h2 id="education-heading">Education</h2></div>
    <ol class="cv-list">
      {education.map(item => <li><time>{item.year}</time><div><p>{item.detail}</p>{item.note && <p class="cv-note">{item.note}</p>}</div></li>)}
    </ol>
  </section>

  <section class="section cv-section exhibition-cv-section solo-exhibitions" aria-labelledby="solo-heading">
    <div class="cv-heading"><h2 id="solo-heading"><em>Solo<br/>exhibitions</em></h2></div>
    <ol class="cv-list">
      {soloExhibitions.map(([year, detail, slug]) => (
        <li>
          <time>{year}</time>
          <p>
            {slug
              ? <a class="cv-exhibition-link" href={`/exhibition/${slug}/`}><span>{detail}</span><span aria-hidden="true">&#8594;</span></a>
              : detail}
          </p>
        </li>
      ))}
    </ol>
  </section>

  <section class="section cv-section exhibition-cv-section group-exhibitions" aria-labelledby="group-heading">
    <div class="cv-heading"><h2 id="group-heading">Group<br/><em>exhibitions</em></h2></div>
    <ol class="cv-list">
      {groupExhibitions.map(([year, detail]) => <li><time>{year}</time><p>{detail}</p></li>)}
    </ol>
  </section>

  <section class="statement-section">
    <div class="section statement-inner">
      <p class="eyebrow">Artist statement</p>
      <blockquote>My artistic practice is driven by experimentation and deeply sustained by contemporary literature, philosophy, and feminist theory. I explore the fragile territories of human discourse, emotional connection, and intimacy, seeking visual languages for what I call “tenderness exercises.” Whether creating delicate gallery pieces using watercolor, acrylic ink, and crayons, or working on large-scale paintings on canvas, my work challenges conventional narratives around emotion and identity. I view my art as an active, engaged space - a sanctuary for shared vulnerability, empowerment, and contemporary dialogue on love and resistance.</blockquote>
      <span class="signature">Sara Milojević</span>
    </div>
  </section>
</Layout>
