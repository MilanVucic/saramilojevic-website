---
import Layout from '../../layouts/Layout.astro';
import '../../styles/artwork.css';
import ArtworkCard from '../../components/ArtworkCard.astro';
import BackBreadcrumb from '../../components/BackBreadcrumb.astro';
import ImageCarousel from '../../components/ImageCarousel.astro';
import CTA from '../../components/CTA.astro';
import { getPortfolio, imageUrl, site } from '../../lib/content';

export async function getStaticPaths() {
  const { collections, works } = await getPortfolio();
  return works.map(artwork => {
    const collectionWorks = works.filter(item => item.collection === artwork.collection);
    const artworkIndex = collectionWorks.findIndex(item => item.slug === artwork.slug);
    const related = Array.from(
      { length: Math.min(3, Math.max(0, collectionWorks.length - 1)) },
      (_, offset) => collectionWorks[(artworkIndex + offset + 1) % collectionWorks.length],
    );
    return {
      params: { slug: artwork.slug },
      props: {
        artwork,
        collection: collections.find(collection => collection.slug === artwork.collection)!,
        related,
      },
    };
  });
}

const { artwork: a, collection: c, related } = Astro.props;
const galleryItems = a.images.map((image, index) => ({
  image,
  title: a.title,
  fullSrc: imageUrl(image.full || image.src),
  ariaLabel: `Enlarge ${a.title} image ${index + 1}`,
}));
const carouselFrameRatio = Math.min(...a.images.map(image => image.width / image.height));
---
<Layout
  title={a.title}
  description={a.description}
  socialImage={imageUrl(a.images[0].src)}
  socialImageAlt={a.images[0].alt}
  structuredData={{
    '@type': 'VisualArtwork',
    '@id': `${site.siteUrl.replace(/\/$/, '')}/artwork/${a.slug}/#artwork`,
    name: a.title,
    url: `${site.siteUrl.replace(/\/$/, '')}/artwork/${a.slug}/`,
    description: a.description,
    image: a.images.map(image => imageUrl(image.src)),
    artMedium: a.medium,
    artform: 'Painting',
    dateCreated: a.year ? String(a.year) : undefined,
    creator: { '@id': `${site.siteUrl.replace(/\/$/, '')}/#artist` },
    width: { '@type': 'QuantitativeValue', value: a.dimensions.widthCm, unitCode: 'CMT' },
    height: { '@type': 'QuantitativeValue', value: a.dimensions.heightCm, unitCode: 'CMT' },
    isPartOf: { '@type': 'CreativeWorkSeries', name: c.title, url: `${site.siteUrl.replace(/\/$/, '')}/collection/${c.slug}/` },
  }}
>
  <section class="section artwork-page">
    <div class="detail-meta-row">
      <BackBreadcrumb href={`/collection/${c.slug}/`} label={`Collection: ${c.title}`} />
    </div>
    <div class="artwork-layout">
      <div class="gallery" id="gallery">
        <ImageCarousel
          items={galleryItems}
          label={`${a.title} images`}
          className="artwork-gallery-carousel"
          viewportClass="artwork-gallery-viewport"
          slideClass="artwork-gallery-slide"
          viewportStyle={`aspect-ratio: ${carouselFrameRatio}`}
          eagerFirst
        />
      </div>
      <aside class="artwork-info">
        <h1>{a.title}</h1>
        {a.description && <p>{a.description}</p>}
        <dl>
          <div><dt>Medium</dt><dd>{a.medium}</dd></div>
          {a.dimensions && <div><dt>Dimensions</dt><dd>{a.dimensions.widthCm} × {a.dimensions.heightCm} cm (W × H)</dd></div>}
          {a.year && <div><dt>Year</dt><dd>{a.year}</dd></div>}
          <div><dt>Availability</dt><dd>{a.available ? 'Available for sale' : 'Not available'}</dd></div>
          {a.readyToHang && <div><dt>Ready to hang</dt><dd>Yes</dd></div>}
        </dl>
        <div class="artwork-enquiry-row">
          <span class="artwork-enquiry-signature-wrap">
            <img class="artwork-enquiry-signature" src="/assets/sara-milojevic-signature.svg" alt="Sara Milojević signature" />
          </span>
          <CTA href={`/contact/?artwork=${encodeURIComponent(a.slug)}`}>Enquire about this work</CTA>
        </div>
      </aside>
    </div>
  </section>
  <section class="section">
    <div class="section-heading"><h2>From the same <em>collection</em></h2><CTA href={`/collection/${c.slug}/`}>View collection</CTA></div>
    <div class="works-grid">{related.map(artwork => <ArtworkCard artwork={artwork}/>)}</div>
  </section>
</Layout>

<script>
  const signatureWrap = document.querySelector('.artwork-enquiry-signature-wrap');

  if (signatureWrap && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let signatureMarkupPromise;

    const drawSignature = async () => {
      try {
        signatureMarkupPromise ||= fetch('/assets/sara-milojevic-signature.svg')
          .then(response => response.ok ? response.text() : Promise.reject());
        const markup = await signatureMarkupPromise;
        const parsed = new DOMParser().parseFromString(markup, 'image/svg+xml');
        const svg = parsed.documentElement;
        const paths = [...svg.querySelectorAll('path')];
        if (!paths.length || parsed.querySelector('parsererror')) return;

        svg.removeAttribute('fill');
        svg.classList.add('signature-drawing');
        svg.setAttribute('role', 'img');
        svg.setAttribute('aria-label', 'Sara Milojević signature');

        paths.forEach(path => {
          const length = path.getTotalLength();
          path.dataset.length = String(length);
          // The source SVG stores pen marks as closed outlines. Their first
          // half follows one edge of the mark; the second half returns along
          // the other edge to close the shape. Reveal only the forward edge.
          const revealLength = length < 32 ? length : length / 2;
          path.style.setProperty('--path-length', String(length));
          path.style.setProperty('--reveal-length', String(revealLength));
          path.style.setProperty('--path-dash', `${revealLength} ${length * 2}`);
          const duration = Math.min(3, Math.max(0.6, revealLength / 1400));
          path.dataset.duration = String(duration);
          path.style.setProperty('--draw-time', `${duration}s`);
        });

        signatureWrap.replaceChildren(document.adoptNode(svg));
        // Force the hidden dash offsets to paint before starting the first path.
        svg.getBoundingClientRect();
        paths.forEach(path => getComputedStyle(path).strokeDashoffset);

        let nextPath = 0;
        const startNextPath = () => {
          const path = paths[nextPath++];
          if (!path) return;
          path.addEventListener('transitionend', event => {
            if (event.propertyName === 'stroke-dashoffset') startNextPath();
          }, { once: true });
          path.classList.add('is-drawing');
        };

        const startWhenFullyVisible = () => {
          const bounds = svg.getBoundingClientRect();
          const fullyVisible = bounds.top >= 0
            && bounds.left >= 0
            && bounds.bottom <= window.innerHeight
            && bounds.right <= window.innerWidth;

          if (fullyVisible) {
            window.removeEventListener('scroll', startWhenFullyVisible);
            window.removeEventListener('resize', startWhenFullyVisible);
            requestAnimationFrame(() => requestAnimationFrame(startNextPath));
          }
        };

        startWhenFullyVisible();
        if (nextPath === 0) {
          window.addEventListener('scroll', startWhenFullyVisible, { passive: true });
          window.addEventListener('resize', startWhenFullyVisible, { passive: true });
        }
      } catch {
        // Keep the static signature image if loading or SVG parsing fails.
      }
    };

    drawSignature();
    window.addEventListener('pageshow', event => {
      if (event.persisted) drawSignature();
    });
  }
</script>
