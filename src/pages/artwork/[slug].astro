---
import Layout from '../../layouts/Layout.astro';
import '../../styles/artwork.css';
import ArtworkCard from '../../components/ArtworkCard.astro';
import BackBreadcrumb from '../../components/BackBreadcrumb.astro';
import ImageCarousel from '../../components/ImageCarousel.astro';
import CTA from '../../components/CTA.astro';
import AnimatedSignature from '../../components/AnimatedSignature.astro';
import { getPortfolio, imageUrl, site, type ArtworkImage as ArtworkImageData } from '../../lib/content';
import { experimentalRoomScenes } from '../../lib/roomScenes';

export async function getStaticPaths() {
  const { collections, works } = await getPortfolio();
  return works.map(artwork => {
    const collectionWorks = works.filter(item => item.collection === artwork.collection);
    const artworkIndex = collectionWorks.findIndex(item => item.slug === artwork.slug);
    const related = Array.from(
      { length: Math.min(3, Math.max(0, collectionWorks.length - 1)) },
      (_, offset) => collectionWorks[(artworkIndex + offset + 1) % collectionWorks.length],
    );
    return {
      params: { slug: artwork.slug },
      props: {
        artwork,
        collection: collections.find(collection => collection.slug === artwork.collection)!,
        related,
      },
    };
  });
}

const { artwork: a, collection: c, related } = Astro.props;
const carouselFrameRatio = a.images[0].width / a.images[0].height;
const originalGalleryItems = a.images.map((image, index) => ({
  image,
  title: a.title,
  fullSrc: imageUrl(image.full || image.src),
  ariaLabel: `Enlarge ${a.title} image ${index + 1}`,
  frameRatio: carouselFrameRatio,
}));

const emptyWallBase = experimentalRoomScenes.find(scene => scene.unlimitedArtworkSize)!;
const isPortraitArtwork = a.dimensions.heightCm > a.dimensions.widthCm;
const emptyWallScene = isPortraitArtwork && emptyWallBase.verticalImage
  ? {
      ...emptyWallBase,
      image: emptyWallBase.verticalImage,
      imageWidth: emptyWallBase.verticalImageWidth!,
      imageHeight: emptyWallBase.verticalImageHeight!,
    }
  : emptyWallBase;
const furnishedRoomIds = ['white-wall-brick', 'bedroom-medium', 'living-room-medium', 'living-room-large'];
const furnishedRooms = furnishedRoomIds
  .map(id => experimentalRoomScenes.find(scene => scene.id === id)!)
  .filter(scene => scene.wall.widthCm && scene.wall.heightCm);
const artworkImage = a.images[0];
const artworkAspectRatio = artworkImage.width / artworkImage.height;
const artworkRenderedHeightCm = a.dimensions.widthCm / artworkAspectRatio;
const compatibleRooms = furnishedRooms.filter(scene =>
  a.dimensions.widthCm <= scene.wall.widthCm! && a.dimensions.heightCm <= scene.wall.heightCm!,
);
const comfortablyFittingRooms = furnishedRooms.filter(scene =>
  a.dimensions.widthCm <= scene.wall.widthCm! * 0.95 && a.dimensions.heightCm <= scene.wall.heightCm! * 0.95,
);
const eligibleRooms = comfortablyFittingRooms.length ? comfortablyFittingRooms : compatibleRooms;
const selectedRooms: typeof furnishedRooms = [];
const addRoom = (room?: (typeof furnishedRooms)[number]) => {
  if (room && !selectedRooms.some(selected => selected.id === room.id)) selectedRooms.push(room);
};
addRoom(compatibleRooms.find(scene => scene.id === 'white-wall-brick'));
// The living-room medium scene is shown for every artwork that physically fits it.
addRoom(compatibleRooms.find(scene => scene.id === 'living-room-medium'));
const additionalMediumRooms = eligibleRooms
  .filter(scene => scene.id !== 'living-room-large')
  .sort((first, second) => {
    const artworkArea = a.dimensions.widthCm * a.dimensions.heightCm;
    const firstWallArea = first.wall.widthCm! * first.wall.heightCm!;
    const secondWallArea = second.wall.widthCm! * second.wall.heightCm!;
    return artworkArea / secondWallArea - artworkArea / firstWallArea;
  });
for (const room of additionalMediumRooms) {
  if (selectedRooms.length >= 3) break;
  addRoom(room);
}
if (!selectedRooms.length) addRoom(eligibleRooms.find(scene => scene.id === 'living-room-large'));

function previewStyle(scene: (typeof experimentalRoomScenes)[number]) {
  const { corners } = scene.wall;
  const safeWidthPct = corners.topRight.xPct - corners.topLeft.xPct;
  const safeHeightPct = corners.bottomLeft.yPct - corners.topLeft.yPct;
  const safeWidthPx = safeWidthPct / 100 * scene.imageWidth;
  const safeHeightPx = safeHeightPct / 100 * scene.imageHeight;
  let widthPx: number;
  let heightPx: number;

  if (scene.unlimitedArtworkSize) {
    const paddingScale = 0.9;
    const fitScale = Math.min(
      safeWidthPx * paddingScale / a.dimensions.widthCm,
      safeHeightPx * paddingScale / artworkRenderedHeightCm,
    );
    widthPx = a.dimensions.widthCm * fitScale;
    heightPx = widthPx / artworkAspectRatio;
  } else {
    const wallWidth = scene.wall.widthCm!;
    const wallHeight = scene.wall.heightCm!;
    const pxPerCm = Math.min(safeWidthPx / wallWidth, safeHeightPx / wallHeight);
    const fitScale = Math.min(safeWidthPx / a.dimensions.widthCm, safeHeightPx / artworkRenderedHeightCm);
    const scale = Math.min(pxPerCm, fitScale);
    widthPx = a.dimensions.widthCm * scale;
    heightPx = widthPx / artworkAspectRatio;
  }

  const centerXPct = corners.topLeft.xPct + safeWidthPct / 2;
  const centerYPct = corners.topLeft.yPct + safeHeightPct / 2;
  return `--art-center-x:${centerXPct}%;--art-center-y:${centerYPct}%;--art-width:${widthPx / scene.imageWidth * 100}%;--art-height:${heightPx / scene.imageHeight * 100}%;--shadow-x:${scene.shadowOffsetPx.x}px;--shadow-y:${scene.shadowOffsetPx.y}px;`;
}

const roomGalleryItems = [emptyWallScene, ...selectedRooms].map(scene => {
  const background: ArtworkImageData = {
    src: scene.image,
    width: scene.imageWidth,
    height: scene.imageHeight,
    alt: `${scene.title} background`,
  };
  const title = scene.unlimitedArtworkSize
    ? 'On a blank wall'
    : scene.id === 'white-wall-brick'
      ? 'On the white brick wall'
      : `In the ${scene.title.toLowerCase()}`;
  return {
    image: artworkImage,
    title,
    frameRatio: carouselFrameRatio,
    roomPreview: {
      background,
      artworkStyle: previewStyle(scene),
      artworkAlt: `${a.title} placed ${scene.unlimitedArtworkSize
        ? 'on a blank wall'
        : scene.id === 'white-wall-brick'
          ? 'on the white brick wall'
          : `in the ${scene.title.toLowerCase()}`}`,
      artworkFullSrc: imageUrl(artworkImage.full || artworkImage.src),
    },
  };
});
const galleryItems = [...originalGalleryItems, ...roomGalleryItems];
---
<Layout
  title={a.title}
  description={a.description}
  socialImage={imageUrl(a.images[0].src)}
  socialImageAlt={a.images[0].alt}
  structuredData={{
    '@type': 'VisualArtwork',
    '@id': `${site.siteUrl.replace(/\/$/, '')}/artwork/${a.slug}/#artwork`,
    name: a.title,
    url: `${site.siteUrl.replace(/\/$/, '')}/artwork/${a.slug}/`,
    description: a.description,
    image: a.images.map(image => imageUrl(image.src)),
    artMedium: a.medium,
    artform: 'Painting',
    dateCreated: a.year ? String(a.year) : undefined,
    creator: { '@id': `${site.siteUrl.replace(/\/$/, '')}/#artist` },
    width: { '@type': 'QuantitativeValue', value: a.dimensions.widthCm, unitCode: 'CMT' },
    height: { '@type': 'QuantitativeValue', value: a.dimensions.heightCm, unitCode: 'CMT' },
    isPartOf: { '@type': 'CreativeWorkSeries', name: c.title, url: `${site.siteUrl.replace(/\/$/, '')}/collection/${c.slug}/` },
  }}
>
  <section class="section artwork-page">
    <div class="detail-meta-row">
      <BackBreadcrumb href={`/collection/${c.slug}/`} label={`Collection: ${c.title}`} />
    </div>
    <div class="artwork-layout">
      <div class="gallery" id="gallery">
        <ImageCarousel
          items={galleryItems}
          label={`${a.title} images and room views`}
          className="artwork-gallery-carousel"
          viewportClass="artwork-gallery-viewport"
          slideClass="artwork-gallery-slide"
          viewportStyle={`aspect-ratio: ${carouselFrameRatio}`}
          eagerFirst
        />
      </div>
      <aside class="artwork-info">
        <h1>{a.title}</h1>
        {a.description && <p>{a.description}</p>}
        <dl>
          <div><dt>Medium</dt><dd>{a.medium}</dd></div>
          {a.dimensions && <div><dt>Dimensions</dt><dd>{a.dimensions.widthCm} × {a.dimensions.heightCm} cm (W × H)</dd></div>}
          {a.year && <div><dt>Year</dt><dd>{a.year}</dd></div>}
          <div><dt>Availability</dt><dd>{a.available ? 'Available for sale' : 'Not available'}</dd></div>
          {a.readyToHang && <div><dt>Ready to hang</dt><dd>Yes</dd></div>}
        </dl>
        <div class="artwork-enquiry-row">
          <AnimatedSignature className="artwork-enquiry-signature-wrap" />
          <CTA href={`/contact/?artwork=${encodeURIComponent(a.slug)}`}>Enquire about this work</CTA>
        </div>
      </aside>
    </div>
  </section>
  <section class="section">
    <div class="section-heading"><h2>From the same <em>collection</em></h2><CTA href={`/collection/${c.slug}/`}>View collection</CTA></div>
    <div class="works-grid">{related.map(artwork => <ArtworkCard artwork={artwork}/>)}</div>
  </section>
</Layout>

